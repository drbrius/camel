# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"


# ─────────────────────────────────────────────────────────────────────────────
# FTMO Trading Bot (bot/) – see bot/README.md
#
# Every value below is optional. The defaults run the bot in paper mode on
# synthetic data, which cannot place a real order.
# ─────────────────────────────────────────────────────────────────────────────

# --- Broker -----------------------------------------------------------------
# paper  = full simulation, no real money (default)
# metaapi = live FTMO MetaTrader 5 account via metaapi.cloud
BOT_BROKER="paper"

# Log every decision without sending a single order. Run this against live data
# for at least a week before switching it off.
BOT_DRY_RUN="false"

METAAPI_TOKEN=""
METAAPI_ACCOUNT_ID=""
METAAPI_REGION="new-york"

# --- FTMO account -----------------------------------------------------------
# Must match the real account: a 100k rule set on a 10k account sizes every
# trade 10x. The bot refuses to start if they disagree.
FTMO_PHASE="challenge"          # challenge | verification | funded
FTMO_ACCOUNT_SIZE="100000"
FTMO_CURRENCY="USD"

# Swing accounts may hold over the weekend and trade through news.
# Leave false for a normal account – the restrictions are contractual.
FTMO_SWING_ACCOUNT="false"

# --- Risk -------------------------------------------------------------------
# conservative is the only preset recommended for a real challenge: the daily
# hard stop fires at 2.5%, half of FTMO's 5% limit.
RISK_PROFILE="conservative"     # conservative | balanced | aggressive
RISK_PER_TRADE_PCT="0.25"
RISK_MAX_TRADES_PER_DAY="6"
RISK_MAX_POSITIONS="3"

# --- Trading ----------------------------------------------------------------
BOT_SYMBOLS="EURUSD,GBPUSD,XAUUSD"
BOT_STRATEGIES="trend-breakout,mean-reversion"
BOT_TIMEFRAME="M15"
BOT_HIGHER_TIMEFRAME="H4"
BOT_LOOP_SECONDS="30"

# Must cover the higher timeframe's warm-up: an H4 EMA(50) needs 800 M15 bars.
BOT_HISTORY_BARS="1500"

# Risk state and the trade journal live here. Mount this as a persistent volume
# in production – losing it resets the daily loss counter on every restart.
BOT_DATA_DIR="data/bot"
